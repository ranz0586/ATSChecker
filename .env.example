# Select openai or gemini, supply its key, and restart the server.
AI_PROVIDER=gemini
AI_API_KEY=
# Optional: leave empty to use the selected provider's default model.
AI_MODEL=
# Alternatively, use the provider-specific key. Existing OpenAI settings still work.
OPENAI_API_KEY=
GEMINI_API_KEY=
PORT=3000
# Required only for the private Vercel API. Use a unique password of 24+ characters.
# Sign in at /api/config with username align. Never prefix this variable with VITE_.
APP_PASSWORD=
